{
  "config": {
    "step": {
      "user": {
        "title": "Connect to the inverter",
        "description": "Enter the address of the inverter or of its VSN300 / VSN700 datalogger card. The inverter must be awake: a PVI without grid power answers nothing at night.",
        "data": {
          "host": "Host",
          "port": "Port"
        },
        "data_description": {
          "host": "IP address or host name of the inverter or datalogger.",
          "port": "Modbus TCP port, 502 unless changed on the device."
        },
        "sections": {
          "advanced": {
            "name": "Advanced settings",
            "description": "The defaults fit a VSN300 or VSN700 datalogger. A natively Modbus inverter such as a REACT2 usually needs unit ID 1 and base address 40000.",
            "data": {
              "unit_id": "Modbus unit ID",
              "base_address": "SunSpec base address"
            },
            "data_description": {
              "unit_id": "The Modbus unit (slave) ID the inverter answers on. VSN cards use 2, some firmwares 247.",
              "base_address": "The register the SunSpec map starts at: 0 behind a VSN card, 40000 on a natively Modbus inverter."
            }
          }
        }
      },
      "reconfigure": {
        "title": "Change the connection",
        "description": "Update how Home Assistant reaches this inverter. It must still be the same inverter.",
        "data": {
          "host": "Host",
          "port": "Port"
        },
