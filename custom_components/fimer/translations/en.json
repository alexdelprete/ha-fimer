{
  "config": {
    "step": {
      "user": {
        "title": "FIMER (ABB / Power-One)",
        "description": "An earlier ABB/FIMER PVI VSN REST entry exists. Take over its settings and entities, or set up a new inverter.",
        "menu_options": {
          "manual": "Set up a new inverter",
          "legacy": "Take over an existing REST entry"
        }
      },
      "reconfigure": {
        "title": "Change the connection",
        "description": "Update how Home Assistant reaches this inverter. It must still be the same inverter.",
        "data": {
          "host": "Host",
          "port": "Port"
        },
        "data_description": {
          "host": "IP address or host name of the inverter or datalogger.",
          "port": "Modbus TCP port, 502 unless changed on the device."
        },
        "sections": {
          "modbus": {
            "name": "Modbus TCP (SunSpec)",
            "description": "The defaults fit a VSN300 or VSN700 datalogger. A natively Modbus inverter such as a REACT2 usually needs unit ID 1 and base address 40000.",
            "data": {
              "use_modbus": "Read over Modbus TCP",
              "unit_id": "Modbus unit ID",
              "base_address": "SunSpec base address"
            },
            "data_description": {
              "use_modbus": "Fast, unauthenticated readings of the SunSpec models. Needs Modbus TCP enabled on the device.",
              "unit_id": "The Modbus unit (slave) ID the inverter answers on. VSN cards use 2, some firmwares 247.",
              "base_address": "The register the SunSpec map starts at: 0 behind a VSN card, 40000 on a natively Modbus inverter."
            }
          },
          "rest": {
            "name": "Datalogger REST API",
            "description": "The VSN300 / VSN700 card's own API adds the datalogger, meters, batteries and the periodic energy counters.",
            "data": {
              "use_rest": "Read the datalogger REST API",
              "username": "Username",
              "password": "Password"
            },
            "data_description": {
              "use_rest": "Also poll the card's REST API. Optional behind a VSN300; the only source for meters and batteries behind a VSN700.",
              "username": "The card's user, usually guest.",
              "password": "The password set on the card, if any."
            }
          }
        }
      },
      "legacy": {
        "title": "Take over a REST entry",
        "description": "The chosen entry is removed and its sensors keep their entity IDs and history under this integration.",
        "data": {
          "legacy_entry": "Entry to take over"
        }
      },
      "manual": {
        "title": "Connect to the inverter",
        "description": "Enter the address of the inverter or of its VSN300 / VSN700 datalogger card and choose the sources to read. The inverter must be awake: a PVI without grid power answers nothing at night.",
        "data": {
          "host": "Host",
          "port": "Port"
        },
        "data_description": {
          "host": "IP address or host name of the inverter or datalogger.",
          "port": "Modbus TCP port, 502 unless changed on the device."
        },
        "sections": {
          "modbus": {
            "name": "Modbus TCP (SunSpec)",
            "description": "The defaults fit a VSN300 or VSN700 datalogger. A natively Modbus inverter such as a REACT2 usually needs unit ID 1 and base address 40000.",
            "data": {
              "use_modbus": "Read over Modbus TCP",
              "unit_id": "Modbus unit ID",
              "base_address": "SunSpec base address"
            },
            "data_description": {
              "use_modbus": "Fast, unauthenticated readings of the SunSpec models. Needs Modbus TCP enabled on the device.",
              "unit_id": "The Modbus unit (slave) ID the inverter answers on. VSN cards use 2, some firmwares 247.",
              "base_address": "The register the SunSpec map starts at: 0 behind a VSN card, 40000 on a natively Modbus inverter."
            }
